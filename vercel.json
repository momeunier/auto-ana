{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/upload-videos", "dest": "app.js" },
    { "src": "/(.*)", "dest": "/dist/$1" }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
